{
  "name": "adaptive-concurrency-limiter",
  "version": "0.0.0",
  "description": "Adaptive, TCP-Vegas-inspired concurrency limiting for Node.js.",
  "keywords": [
    "concurrency",
    "rate-limiting",
    "load-shedding",
    "backpressure",
    "resilience",
    "congestion-control",
    "admission-control"
  ],
  "license": "MIT",
  "author": "Narek Tutundzhian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narektu/adaptive-concurrency-limiter.git"
  },
  "homepage": "https://github.com/narektu/adaptive-concurrency-limiter#readme",
  "bugs": {
    "url": "https://github.com/narektu/adaptive-concurrency-limiter/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "bench": "tsx bench/run-comparison.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "express": "^5.2.1",
    "fast-check": "^4.9.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
